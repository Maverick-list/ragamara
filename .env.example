# =============================================================================
# NULAR — The Living World of Nusantara
# Environment Variables Template (.env.example)
# Copy to .env.local for local development or configure in Vercel Project Settings.
# NEVER commit real secrets, API keys, or service-role credentials to Git.
# =============================================================================

# --- Session Security (Required for Production) ---
NULAR_SESSION_SECRET=replace-with-64-char-cryptographically-random-hex-secret

# --- Supabase Database & Persistent Auth (Optional for local, Required for Production Cloud) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key-server-only

# --- Google OAuth 2.0 (Optional — enables Google Sign-In) ---
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth?action=google-callback

# --- Phone OTP / SMS Delivery (Optional — Twilio or Supabase Phone Auth) ---
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+62xxxxxxxxxxx

# --- Email Delivery for Verification & Password Reset (Optional) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
RESEND_API_KEY=replace-with-resend-api-key

# --- AI Cultural Guide & Neural TTS (Optional — Backend Only) ---
GEMINI_API_KEY=replace-with-gemini-api-key-server-only
ELEVENLABS_API_KEY=replace-with-elevenlabs-or-neural-tts-key-optional
GOOGLE_TTS_API_KEY=replace-with-google-cloud-tts-key-optional
